# Copy to .env and fill in
ANTHROPIC_API_KEY=

# Optional
# APP_EMAIL=you@example.com  # with APP_PASSWORD: seeds the owner account on first start (containers)
# APP_PASSWORD=change-me     # otherwise the app asks for email + password on first visit
# AUTH_DISABLED=1            # no sign-in at all; only on a machine nobody else can reach
# TRUST_PROXY=1              # behind a reverse proxy: trust X-Forwarded-* for Secure cookies and rate limiting
PROVIDER=claude
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium
API_PORT=8787
# DATA_DIR=./data   # where projects/ and trash/ live; the Docker image sets /data
